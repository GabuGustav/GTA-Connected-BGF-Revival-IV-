# Environment Variables for Netlify Functions
# Copy this to .env and set your actual API keys

# Supabase Configuration - Get this from your Supabase project settings
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Brevo API Key - Get this from your Brevo account (if still using Brevo)
BREVO_API_KEY=your_brevo_api_key_here

# API Secret Key for HMAC verification (must match jobs_rp config api_secret_key)
API_SECRET_KEY=your_api_secret_key_here
GTA_API_KEY=your_api_secret_key_here

# Environment settings
NODE_ENV=production
